{
  "name": "@RimeLumen/dsh-image-prompt-analyzer",
  "version": "1.0.0",
  "private": true,
  "description": "图像提示词分析插件：把一张图片分析成统一视觉描述 IR，再按目标模型的标准化配置编译成正向 / 抑制提示词与控制方式建议。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "configs",
    "lib",
    "python",
    "res",
    "scripts"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=2.0.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "test": "node scripts/core-baseline.test.mjs",
    "import-tags": "node scripts/import-tags.mjs",
    "export-experiences": "node scripts/export-experiences.mjs",
    "inspect-prompt": "node scripts/inspect-prompt.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
