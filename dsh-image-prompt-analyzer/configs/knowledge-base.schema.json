{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://RimeLumen.dsh/dsh-image-prompt-analyzer/configs/knowledge-base.schema.json",
  "title": "标签知识库配置（2.0，纯本地）",
  "description": "DSH 图像提示词分析插件的标签知识库配置结构。2.0 只支持本地文件导入，不再有在线源、缓存与同步段。",
  "type": "object",
  "required": ["schema_version", "config_id", "storage", "sources", "lookup", "categories"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0",
      "description": "本配置结构自身的版本。"
    },
    "config_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 64,
      "description": "同类配置内唯一的稳定小写 ID；用户覆盖配置按它匹配。"
    },
    "display_name": { "type": "string", "maxLength": 120 },
    "description": { "type": "string", "maxLength": 2000 },
    "enabled": { "type": "boolean", "default": true },
    "strict_mode": {
      "type": "boolean",
      "default": false,
      "description": "为真时未知字段直接报错；为假时只警告。"
    },

    "storage": {
      "type": "object",
      "required": ["backend", "database_path"],
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "enum": ["sqlite"] },
        "database_path": {
          "type": "string",
          "minLength": 1,
          "description": "相对插件包目录的路径，禁止绝对路径与越权。"
        },
        "experience_export_path": { "type": "string", "minLength": 1 },
        "create_if_missing": { "type": "boolean", "default": true },
        "backup_before_migration": { "type": "boolean", "default": true }
      }
    },

    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },

    "lookup": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "const": "local_only",
          "description": "2.0 只查本地库；联网查询已删除。"
        }
      }
    },

    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },

    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test_database_writable": { "type": "boolean", "default": true },
        "log_level": { "type": "string", "enum": ["debug", "info", "warn", "error"], "default": "info" }
      }
    }
  },

  "$defs": {
    "source": {
      "type": "object",
      "required": ["source_id", "type", "enabled", "format", "path"],
      "additionalProperties": false,
      "properties": {
        "source_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "maxLength": 64 },
        "type": { "type": "string", "const": "local_file" },
        "enabled": { "type": "boolean" },
        "display_name": { "type": "string", "maxLength": 120 },
        "format": {
          "type": "string",
          "enum": ["csv", "xlsx", "docx", "pdf", "txt", "md"],
          "description": "本地文件格式；每种格式由 lib/kb/readers 下对应读取器解析。"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "相对插件包目录的文件路径，禁止绝对路径与越权。"
        },
        "has_header": {
          "oneOf": [{ "type": "boolean" }, { "type": "string", "const": "auto" }],
          "default": "auto",
          "description": "CSV 首行是否为表头；auto 时按首行是否命中列名同义词判断。"
        },
        "delimiter": { "type": "string", "minLength": 1, "maxLength": 1, "default": "," },
        "column_map": {
          "type": "object",
          "additionalProperties": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "integer", "minimum": 0 }] },
          "description": "列语义声明：字段名 → 表头名或 0 起始的列下标。只写数据文件里真实存在的列。"
        },
        "native_category_map": {
          "type": "object",
          "additionalProperties": { "type": "string", "enum": ["general", "artist", "copyright", "character", "meta"] },
          "description": "数据文件里的原生类目取值 → Danbooru 五类；缺省按 0/1/3/4/5 映射。"
        },
        "sheet_name": { "type": "string", "minLength": 1, "description": "xlsx 读取的工作表名；缺省取第一个。" },
        "limit": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }], "description": "只导前 N 行，调试用；null 表示全量。" }
      }
    },
    "category": {
      "type": "object",
      "required": ["category_id", "enabled"],
      "additionalProperties": false,
      "properties": {
        "category_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "enabled": { "type": "boolean" },
        "display_name": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "native_categories": {
          "type": "array",
          "items": { "type": "string", "enum": ["general", "artist", "copyright", "character", "meta"] }
        }
      }
    }
  }
}
